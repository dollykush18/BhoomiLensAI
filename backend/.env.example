PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bhoomilens
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed origins (frontend + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_EMAIL=admin@bhoomilens.ai
ADMIN_PASSWORD=ChangeMe123!
# Contact string sent in the scraper User-Agent so site owners can reach you
SCRAPER_CONTACT=you@example.com
# Seconds-delay between requests to the same site
SCRAPER_DELAY_MS=2500
# Cron expression for automatic scraping (empty = disabled). Example: daily at 3am
SCRAPE_CRON=
