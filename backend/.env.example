# TEMPLATE ONLY - this file is committed to git and is public.
# Copy it to .env and put your real values THERE. Never type a real
# password, connection string or secret into this file.
#   Windows:  copy .env.example .env
PORT=5000

# Local MongoDB, or an Atlas connection string ending in /bhoomilens:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bhoomilens
MONGO_URI=mongodb://127.0.0.1:27017/bhoomilens

# Any long random string (32+ characters) - generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins (frontend + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Login for the admin panel - choose your own password in .env
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Contact address sent in the scraper User-Agent so site owners can reach you
SCRAPER_CONTACT=you@example.com

# Milliseconds to wait between requests to the same site
SCRAPER_DELAY_MS=2500

# Cron expression for automatic scraping (empty = disabled). Example: 0 3 * * *
SCRAPE_CRON=
